# Envoi du formulaire de contact (copier vers .env.local et remplir).
# Sans ces trois variables, le formulaire affiche un lien mailto au lieu d'envoyer.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Destinataires (par défaut : l'adresse de la section contact des données).
# Plusieurs adresses : les séparer par des virgules, ex. « a@exemple.fr, b@exemple.fr ».
CONTACT_TO=
